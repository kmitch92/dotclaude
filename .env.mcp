# =============================================================================
# MCP Server Environment Variables Template
# =============================================================================
# This is a template file. Copy to .env.mcp.local and add your actual API keys.
# .env.mcp.local is gitignored and will not be committed to version control.
#
# Usage:
#   cp .env.mcp .env.mcp.local
#   # Edit .env.mcp.local with your actual keys
#   ./scripts/setup-mcp.sh
#
# =============================================================================

# Context7 API Key
# Get your API key from: https://console.upstash.com
# Format: ctx7sk-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CONTEXT7_API_KEY=your_api_key_here

# TaskMaster API Key
# Uses Anthropic API for AI-powered task management features
# Get your API key from: https://console.anthropic.com
# Format: sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Note: TaskMaster can work with multiple AI providers, but Anthropic is primary for Claude Code
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# CodeRAG Configuration
# =============================================================================
# CodeRAG provides a code knowledge graph using Neo4j for intelligent
# code search, analysis, and understanding across your repositories.
#
# Setup: ./scripts/setup-coderag.sh
# Docs: ./docs/coderag-setup.md
# =============================================================================

# Neo4j password for CodeRAG knowledge graph database (REQUIRED)
# Choose a secure password - this protects your code analysis data
CODERAG_NEO4J_PASSWORD=your_neo4j_password_here

# Data persistence directory (optional, default: ~/neo4j-coderag)
# CODERAG_DATA_DIR=${HOME}/neo4j-coderag

# =============================================================================
# Optional CodeRAG Integrations (uncomment to enable)
# =============================================================================

# GitHub integration for scanning remote repositories
# Get token from: https://github.com/settings/tokens
# Required scope: repo (private) or public_repo (public only)
# CODERAG_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxx

# Semantic search with OpenAI embeddings
# Get key from: https://platform.openai.com/api-keys
# CODERAG_OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# GitLab integration for scanning GitLab repositories
# Get token from: GitLab > Settings > Access Tokens
# Required scope: read_repository
# CODERAG_GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxx
# CODERAG_GITLAB_HOST=gitlab.com
