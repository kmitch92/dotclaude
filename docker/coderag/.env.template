# =============================================================================
# CodeRAG Docker Environment Template
# =============================================================================
# Copy to .env and configure before running docker-compose
#
# Usage:
#   cp .env.template .env
#   # Edit .env with your values
#   docker compose up -d
# =============================================================================

# Neo4j Configuration
# Password for the neo4j user (REQUIRED)
CODERAG_NEO4J_PASSWORD=your_neo4j_password_here

# Data persistence directory (default: ~/neo4j-coderag)
# Stores Neo4j data, logs, and plugins
CODERAG_DATA_DIR=${HOME}/neo4j-coderag
