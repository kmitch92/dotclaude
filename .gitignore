# dotclaude .gitignore - Whitelist Strategy
# Ignore everything by default, then explicitly allow what we want to track

# =============================================================================
# IGNORE EVERYTHING BY DEFAULT
# =============================================================================
*

# =============================================================================
# ROOT LEVEL FILES - ALLOW
# =============================================================================
!.gitignore
!README.md
!install.sh
!.env.mcp

# =============================================================================
# MCP DIRECTORY - ALLOW ALL
# =============================================================================
!mcp/
!mcp/**

# =============================================================================
# SCRIPTS DIRECTORY - ALLOW ALL
# =============================================================================
!scripts/
!scripts/**

# =============================================================================
# PROFILES DIRECTORY - SELECTIVE ALLOW
# =============================================================================
!profiles/
!profiles/*/
!profiles/*/.claude/

# Profile configuration files - ALLOW
!profiles/*/.claude/CLAUDE.md
!profiles/*/.claude/CHANGELOG_TEMPLATE.md
!profiles/*/.claude/settings.json

# Profile agents - ALLOW ALL
!profiles/*/.claude/agents/
!profiles/*/.claude/agents/**

# Profile docs - ALLOW ALL
!profiles/*/.claude/docs/
!profiles/*/.claude/docs/**

# Profile plugins - ALLOW ALL
!profiles/*/.claude/plugins/
!profiles/*/.claude/plugins/**

# Profile scripts - ALLOW ALL
!profiles/*/.claude/scripts/
!profiles/*/.claude/scripts/**

# Profile commands - ALLOW ALL
!profiles/*/.claude/commands/
!profiles/*/.claude/commands/**

# =============================================================================
# LEGACY CLAUDE DIRECTORY - KEEP FOR BACKWARD COMPATIBILITY
# =============================================================================
!claude/
!claude/.claude/

# Claude root configuration files - ALLOW
!claude/.claude/CLAUDE.md
!claude/.claude/CHANGELOG_TEMPLATE.md
!claude/.claude/settings.json

# Claude agents - ALLOW ALL
!claude/.claude/agents/
!claude/.claude/agents/**

# Claude docs - ALLOW ALL
!claude/.claude/docs/
!claude/.claude/docs/**

# Claude plugins - ALLOW ALL
!claude/.claude/plugins/
!claude/.claude/plugins/**

# Claude scripts - ALLOW ALL
!claude/.claude/scripts/
!claude/.claude/scripts/**

# Claude commands - ALLOW ALL
!claude/.claude/commands/
!claude/.claude/commands/**

# =============================================================================
# RUNTIME/GENERATED FILES - EXPLICIT IGNORES
# =============================================================================
# These are explicitly ignored even if parent directories are allowed

# Profile runtime directories (applies to all profiles)
profiles/*/.claude/debug/
profiles/*/.claude/debug/**
profiles/*/.claude/history.jsonl
profiles/*/.claude/shell-snapshots/
profiles/*/.claude/shell-snapshots/**
profiles/*/.claude/statsig/
profiles/*/.claude/statsig/**
profiles/*/.claude/todos/
profiles/*/.claude/todos/**
profiles/*/.claude/projects/
profiles/*/.claude/projects/**
profiles/*/.claude/file-history/
profiles/*/.claude/file-history/**
profiles/*/.claude/session-env/
profiles/*/.claude/session-env/**
profiles/*/.claude/ide/
profiles/*/.claude/ide/**

# Claude runtime directories (legacy)
claude/.claude/debug/
claude/.claude/debug/**
claude/.claude/history.jsonl
claude/.claude/shell-snapshots/
claude/.claude/shell-snapshots/**
claude/.claude/statsig/
claude/.claude/statsig/**
claude/.claude/todos/
claude/.claude/todos/**
claude/.claude/projects/
claude/.claude/projects/**
claude/.claude/file-history/
claude/.claude/file-history/**
claude/.claude/session-env/
claude/.claude/session-env/**
claude/.claude/ide/
claude/.claude/ide/**

# Log files (all locations)
profiles/*/.claude/*.log
claude/.claude/*.log

# Local settings and secrets
profiles/*/.claude/settings.local.json
claude/.claude/settings.local.json
.env.mcp.local
**/*.local

# System files
.DS_Store
**/.DS_Store

# =============================================================================
# WORKTREES - IGNORE
# =============================================================================
/worktrees/

# =============================================================================
# NOTES
# =============================================================================
# This whitelist approach ensures:
# 1. Only explicitly allowed files/directories are tracked
# 2. New files/directories are ignored by default (safe by default)
# 3. Runtime and generated files never leak into version control
# 4. Clear separation between template (.env.mcp) and local secrets (.env.mcp.local)
# 5. Supports both legacy claude/ and new profiles/ structure
