#!/usr/bin/env bash

# =============================================================================
# dotclaude CLI Tool
# =============================================================================
# Unified command-line interface for Claude Code profile and MCP management
#
# Usage: dotclaude <command> [subcommand] [args...]
# =============================================================================

set -euo pipefail
IFS=$'\n\t'

# Version
readonly DOTCLAUDE_VERSION="1.0.0"

# =============================================================================
# Path Resolution
# =============================================================================

# Resolve the actual script location (following symlinks)
resolve_script_path() {
  local source="${BASH_SOURCE[0]}"

  # Resolve symlinks to find actual script location
  while [[ -L "$source" ]]; do
    local dir
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    # Handle relative symlinks
    [[ "$source" != /* ]] && source="$dir/$source"
  done

  echo "$(cd -P "$(dirname "$source")" && pwd)"
}

readonly SCRIPT_DIR="$(resolve_script_path)"
readonly REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
readonly SCRIPTS_DIR="$REPO_ROOT/scripts"
readonly PROFILES_DIR="$REPO_ROOT/profiles"

# =============================================================================
# Source Utilities
# =============================================================================

if [[ -f "$SCRIPTS_DIR/utils.sh" ]]; then
  source "$SCRIPTS_DIR/utils.sh"
else
  echo "Error: Cannot find utils.sh at $SCRIPTS_DIR/utils.sh" >&2
  echo "The dotclaude installation may be broken." >&2
  echo "Try reinstalling: cd $REPO_ROOT && ./install.sh" >&2
  exit 1
fi

# =============================================================================
# Repository Validation
# =============================================================================

validate_repo() {
  # Check if repo root exists and has expected structure
  if [[ ! -d "$REPO_ROOT" ]]; then
    print_error "dotclaude repository not found at: $REPO_ROOT"
    print_info "The symlink may be broken. Reinstall with:"
    print_info "  git clone <repo-url> && cd dotclaude && ./install.sh"
    return 1
  fi

  if [[ ! -d "$SCRIPTS_DIR" ]]; then
    print_error "Scripts directory missing: $SCRIPTS_DIR"
    print_info "Repository structure is corrupted. Try reinstalling."
    return 1
  fi

  return 0
}

# =============================================================================
# Usage Information
# =============================================================================

show_version() {
  echo "dotclaude version $DOTCLAUDE_VERSION"
}

show_usage() {
  cat << EOF
dotclaude - Claude Code Profile & MCP Manager

Usage: dotclaude <command> [subcommand] [args...]

Commands:
  profile, p            Manage Claude configuration profiles
    list, ls              List available profiles with stats
    switch, sw <name|n>   Switch to a profile (by name or number)
    add <git-url> [name]  Add external profile as git submodule
    current               Show currently active profile

  mcp, m                Manage MCP (Model Context Protocol) configuration
    setup                 Deploy MCP configuration to ~/.mcp.json
    tools                 List available MCP tools
    edit                  Open .env.mcp.local in editor

  update                Re-run installation (update symlinks, etc.)
  version, -v           Show version information
  commands              List all available commands
  help, -h              Show this help message

Examples:
  dotclaude profile list
  dotclaude profile switch default
  dotclaude profile switch 1
  dotclaude p sw 2
  dotclaude mcp setup
  dotclaude update

For more information, visit: https://github.com/kielbm/dotclaude
EOF
}

show_commands() {
  cat << EOF
Available commands:

  dotclaude profile list         List all profiles with statistics
  dotclaude profile switch <n>   Switch to profile by name or number
  dotclaude profile add <url>    Add external profile repository
  dotclaude profile current      Show currently active profile
  dotclaude mcp setup            Setup/refresh MCP configuration
  dotclaude mcp tools            List configured MCP tools
  dotclaude mcp edit             Edit MCP environment variables
  dotclaude update               Re-run installation
  dotclaude version              Show version
  dotclaude commands             Show this list
  dotclaude help                 Show full help

Aliases: profile -> p, mcp -> m, list -> ls, switch -> sw
EOF
}

# =============================================================================
# Profile Commands
# =============================================================================

# Helper: Get profile name by number from sorted list
get_profile_by_number() {
  local number="$1"
  local profiles=()

  # Collect local profiles
  for entry in "$PROFILES_DIR"/*; do
    [[ -e "$entry" ]] || continue
    [[ -d "$entry" ]] || continue
    local name
    name=$(basename "$entry")
    [[ "$name" == "active" ]] && continue
    [[ "$name" == "external" ]] && continue

    profiles+=("$name")
  done

  # Collect external profiles
  if [[ -d "$PROFILES_DIR/external" ]]; then
    for entry in "$PROFILES_DIR/external"/*; do
      [[ -e "$entry" ]] || continue
      [[ -d "$entry" ]] || continue
      local name
      name="external/$(basename "$entry")"
      profiles+=("$name")
    done
  fi

  # Sort and get by number (1-indexed)
  if [[ ${#profiles[@]} -eq 0 ]]; then
    return 1
  fi

  IFS=$'\n' sorted=($(printf '%s\n' "${profiles[@]}" | sort))
  unset IFS

  local index=$((number - 1))
  if [[ $index -ge 0 ]] && [[ $index -lt ${#sorted[@]} ]]; then
    echo "${sorted[$index]}"
    return 0
  fi

  return 1
}

cmd_profile_list() {
  exec bash "$SCRIPTS_DIR/list-profiles.sh" "$@"
}

cmd_profile_switch() {
  local target="${1:-}"

  if [[ -z "$target" ]]; then
    print_error "Profile name or number required"
    echo ""
    print_info "Usage: dotclaude profile switch <name|number>"
    print_info "Run 'dotclaude profile list' to see available profiles"
    return 1
  fi

  # Check if target is a number (for numbered selection)
  if [[ "$target" =~ ^[0-9]+$ ]]; then
    # Convert number to profile name
    local profile_name
    if ! profile_name=$(get_profile_by_number "$target"); then
      print_error "No profile found at position $target"
      print_info "Run 'dotclaude profile list' to see available profiles"
      return 1
    fi

    if [[ -z "$profile_name" ]]; then
      print_error "No profile found at position $target"
      print_info "Run 'dotclaude profile list' to see available profiles"
      return 1
    fi

    print_info "Switching to profile #$target: $profile_name"
    target="$profile_name"
  fi

  exec bash "$SCRIPTS_DIR/switch-profile.sh" "$target"
}

cmd_profile_add() {
  exec bash "$SCRIPTS_DIR/add-profile.sh" "$@"
}

cmd_profile_current() {
  local active_link="$PROFILES_DIR/active"

  if [[ -L "$active_link" ]]; then
    local current
    current=$(readlink "$active_link")
    current="${current%/}"
    print_success "Current profile: $current"
  else
    print_warning "No active profile set"
    print_info "Run 'dotclaude profile switch <name>' to activate a profile"
    return 1
  fi
}

cmd_profile() {
  local subcmd="${1:-}"
  shift || true

  case "$subcmd" in
    list|ls)
      cmd_profile_list "$@"
      ;;
    switch|sw)
      cmd_profile_switch "$@"
      ;;
    add)
      cmd_profile_add "$@"
      ;;
    current)
      cmd_profile_current "$@"
      ;;
    ""|help|-h)
      cat << EOF
Profile management commands:

  dotclaude profile list           List all profiles with statistics
  dotclaude profile switch <name>  Switch to profile by name
  dotclaude profile switch <n>     Switch to profile by number
  dotclaude profile add <url>      Add external profile repository
  dotclaude profile current        Show currently active profile

Aliases: list -> ls, switch -> sw
EOF
      ;;
    *)
      print_error "Unknown profile command: $subcmd"
      print_info "Run 'dotclaude profile help' for available commands"
      return 1
      ;;
  esac
}

# =============================================================================
# MCP Commands
# =============================================================================

cmd_mcp_setup() {
  exec bash "$SCRIPTS_DIR/setup-mcp.sh" "$@"
}

cmd_mcp_tools() {
  exec bash "$SCRIPTS_DIR/list-mcp-tools.sh" "$@"
}

cmd_mcp_edit() {
  local env_file="$REPO_ROOT/.env.mcp.local"

  # Create from template if doesn't exist
  if [[ ! -f "$env_file" ]]; then
    print_warning ".env.mcp.local not found"
    print_info "Creating from template..."
    cp "$REPO_ROOT/.env.mcp" "$env_file"
    print_success "Created .env.mcp.local"
  fi

  # Determine editor
  local editor="${EDITOR:-${VISUAL:-}}"

  if [[ -z "$editor" ]]; then
    # Try common editors
    if command_exists code; then
      editor="code --wait"
    elif command_exists vim; then
      editor="vim"
    elif command_exists nano; then
      editor="nano"
    elif command_exists vi; then
      editor="vi"
    else
      print_error "No editor found"
      print_info "Set EDITOR environment variable or install vim/nano"
      print_info "File location: $env_file"
      return 1
    fi
  fi

  print_info "Opening $env_file with $editor..."
  $editor "$env_file"

  # Prompt to re-deploy
  echo ""
  if confirm "Re-deploy MCP configuration now?"; then
    bash "$SCRIPTS_DIR/setup-mcp.sh"
  else
    print_info "Run 'dotclaude mcp setup' when ready to apply changes"
  fi
}

cmd_mcp() {
  local subcmd="${1:-}"
  shift || true

  case "$subcmd" in
    setup)
      cmd_mcp_setup "$@"
      ;;
    tools)
      cmd_mcp_tools "$@"
      ;;
    edit)
      cmd_mcp_edit "$@"
      ;;
    ""|help|-h)
      cat << EOF
MCP configuration commands:

  dotclaude mcp setup    Deploy MCP configuration to ~/.mcp.json
  dotclaude mcp tools    List available MCP tools
  dotclaude mcp edit     Edit .env.mcp.local in your editor
EOF
      ;;
    *)
      print_error "Unknown mcp command: $subcmd"
      print_info "Run 'dotclaude mcp help' for available commands"
      return 1
      ;;
  esac
}

# =============================================================================
# Update Command
# =============================================================================

cmd_update() {
  print_header "Updating dotclaude"

  # Pull latest if in git repo
  if [[ -d "$REPO_ROOT/.git" ]]; then
    print_info "Pulling latest changes..."
    if git -C "$REPO_ROOT" pull --ff-only 2>/dev/null; then
      print_success "Repository updated"
    else
      print_warning "Could not pull updates (may have local changes or not on a branch)"
    fi
  fi

  # Re-run installer
  print_info "Re-running installation..."
  exec bash "$REPO_ROOT/install.sh" --skip-deps "$@"
}

# =============================================================================
# Main Command Router
# =============================================================================

main() {
  # Validate repository first
  if ! validate_repo; then
    exit 1
  fi

  local cmd="${1:-}"
  shift || true

  case "$cmd" in
    profile|p)
      cmd_profile "$@"
      ;;
    mcp|m)
      cmd_mcp "$@"
      ;;
    update)
      cmd_update "$@"
      ;;
    version|--version|-v)
      show_version
      ;;
    commands)
      show_commands
      ;;
    help|--help|-h)
      show_usage
      ;;
    "")
      show_usage
      ;;
    *)
      print_error "Unknown command: $cmd"
      echo ""
      print_info "Run 'dotclaude help' for available commands"
      exit 1
      ;;
  esac
}

# =============================================================================
# Entry Point
# =============================================================================

main "$@"
